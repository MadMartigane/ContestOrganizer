{
  "compilerOptions": {
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["dom", "es2015", "es2023"],
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2017",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
