{
  "compilerOptions": {
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["dom", "es2023"],
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./src/core/*"]
    },
    "module": "ES2020",
    "target": "ES2023",
    "downlevelIteration": true,
    "types": ["vite/client", "jest"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
