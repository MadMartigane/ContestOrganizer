{
  "compilerOptions": {
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["dom", "es2015", "es2023"],
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2017",
    "downlevelIteration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@components/*": ["src/components/*"],
      "@core/*": ["src/core/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
