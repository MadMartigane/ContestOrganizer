{
  "name": "contest-organizer",
  "private": true,
  "version": "0.5.0",
  "description": "Tool to organize & enjoy your sport contest.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "proxy": "node ./scripts/proxy.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "deploy:preprod": "bash scripts/deploy.sh pre-prod",
    "deploy:prod:dry-run": "bash scripts/deploy.sh prod --dry-run",
    "deploy:preprod:dry-run": "bash scripts/deploy.sh pre-prod --dry-run",
    "deploy:backup": "bash scripts/deploy.sh backup",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts --skip-git --skip-push",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "dev": "vite",
    "dev:modern": "vite"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@rollup/plugin-replace": "^6.0.3",
    "@awesome.me/webawesome": "latest",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jsdom": "^29.0.0",
    "rollup": "^4.60.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "ultracite": "^7.2.3",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">= 20.19.0",
    "pnpm": ">= 8.x"
  },
  "license": "MIT"
}
