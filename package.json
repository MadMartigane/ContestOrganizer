{
  "name": "contest-organizer",
  "private": true,
  "version": "0.0.1",
  "description": "Tool to organize & enjoy your sport contest.",
  "type": "module",
  "scripts": {
    "build": "stencil build && pnpm clean-build",
    "start": "stencil build --dev --watch --serve",
    "test": "pnpm test:stencil && pnpm test:vitest",
    "test:stencil": "stencil test --spec",
    "test:vitest": "vitest run",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "proxy": "node ./scripts/proxy.js",
    "clean-build": "rm -rf www/build/svg",
    "generate": "stencil generate",
    "lint": "biome check .",
    "format": "biome format --write .",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "deploy:preprod": "bash scripts/deploy.sh pre-prod",
    "deploy:backup": "bash scripts/deploy.sh backup",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "dev": "concurrently -k -n \"[STENCIL],[VITE]\" -c \"cyan,green\" \"stencil build --dev --watch --serve\" \"vite\"",
    "dev:modern": "vite",
    "dev:legacy": "stencil build --dev --watch --serve"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@shoelace-style/shoelace": "^2.20.1",
    "@stencil/core": "^4.41.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jsdom": "^26.0.0",
    "puppeteer": "^24.1.1",
    "rollup": "^4.28.0",
    "stencil-tailwind-plugin": "^1.8.0",
    "tailwindcss": "^3.4.17",
    "ultracite": "^7.2.3",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">= 18.x",
    "pnpm": ">= 8.x"
  },
  "license": "MIT"
}
