{
  "name": "contest-organizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ultracite check .",
    "format": "ultracite fix .",
    "prepare": "husky",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "deploy:preprod": "bash scripts/deploy.sh pre-prod",
    "deploy:prod:dry-run": "bash scripts/deploy.sh prod --dry-run",
    "deploy:preprod:dry-run": "bash scripts/deploy.sh pre-prod --dry-run",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts patch --skip-git --skip-push",
    "generate:status": "tsx scripts/generate-status.ts --skip-version"
  },
  "type": "module",
  "dependencies": {
    "@inlang/paraglide-js": "^2.16.0",
    "@skeletonlabs/skeleton": "^4.15.2",
    "@skeletonlabs/skeleton-svelte": "^4.15.2",
    "@tanstack/svelte-query": "^6.1.16",
    "@tanstack/svelte-virtual": "^3.13.24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "ultracite": "^7.6.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
